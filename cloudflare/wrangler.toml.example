name = "mihigo-98-control-plane"
main = "src/index.js"
compatibility_date = "2026-10-01"
[vars]
DAILY_TARGET = "20"
SHORTS_RATIO = "0.5"
[[d1_databases]]
binding = "DB"
database_name = "mihigo-jobs"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
[[r2_buckets]]
binding = "MEDIA"
bucket_name = "mihigo-media"
[triggers]
crons = ["*/15 * * * *"]
